ninja_required_version = 1.10
rule action0
  command = ./tools/action-log gen/config python3 tools/generate-input.py header build/gen/config.h
build build/gen/config.h: action0 inputs/spec.json tools/generate-input.py recipes/gen/config.json
rule action1
  command = ./tools/action-log gen/generated python3 tools/generate-input.py source build/gen/generated.cpp
build build/gen/generated.cpp: action1 inputs/spec.json build/gen/config.h tools/generate-input.py recipes/gen/generated.json
rule action2
  command = ./tools/action-log obj/u000000 g++ -std=c++17 -O2 -g0 -fno-ident -MMD -MP -Iinputs/include -Ibuild/gen -MF build/obj/u000000.o.d -c inputs/src/u000000.cpp -o build/obj/u000000.o
  depfile = build/obj/u000000.o.d
  deps = gcc
build build/obj/u000000.o: action2 inputs/src/u000000.cpp inputs/include/private000000.h inputs/include/module00.h inputs/include/global.h build/gen/config.h recipes/obj/u000000.json
