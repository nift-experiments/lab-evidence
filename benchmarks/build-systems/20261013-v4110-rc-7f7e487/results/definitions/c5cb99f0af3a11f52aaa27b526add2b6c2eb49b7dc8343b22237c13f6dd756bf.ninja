ninja_required_version = 1.10
rule compile
  command = $action_command
  depfile = $out.d
  deps = gcc
rule action
  command = $action_command
build build/gen/config.h: action inputs/spec.json tools/generate-input.py
  action_command = ./tools/action-log gen/config python3 tools/generate-input.py header build/gen/config.h
build build/gen/generated.cpp: action inputs/spec.json build/gen/config.h tools/generate-input.py
  action_command = ./tools/action-log gen/generated python3 tools/generate-input.py source build/gen/generated.cpp
build build/obj/u000000.o: compile inputs/src/u000000.cpp inputs/include/private000000.h inputs/include/module00.h inputs/include/global.h build/gen/config.h
  action_command = ./tools/action-log obj/u000000 g++ -std=c++17 -O2 -g0 -fno-ident -MMD -MP -Iinputs/include -Ibuild/gen -MF build/obj/u000000.o.d -c inputs/src/u000000.cpp -o build/obj/u000000.o
build build/obj/u000001.o: compile inputs/src/u000001.cpp inputs/include/private000001.h inputs/include/module01.h inputs/include/global.h build/gen/config.h
